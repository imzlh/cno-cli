{
    "deno.enable": true,
    "deno.enablePaths": [
        "./tests/",
        "./example/"
    ],
    "cmake.generator": "Ninja",
    "cmake.buildDirectory": "${workspaceFolder}/build",
    "cmake.windows": {
        "cmakePath": "${workspaceFolder}/scripts/cmake-utf8.cmd",
        "outputLogEncoding": "utf-8",
        "configureSettings": {
            "CMAKE_TOOLCHAIN_FILE": "${workspaceFolder}/cmake/vcpkg-toolchain.cmake",
            "VCPKG_TARGET_TRIPLET": "x64-windows"
        }
    },
    "cmake.configureArgs": [
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
    ],
    "cmake.buildArgs": [
        "--parallel"
    ],
    "cmake.buildBeforeRun": true,
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/compile_commands.json"
}
